#!/bin/sh
# Exercise the production SSH bridge arguments without a remote host.
case "$*" in
  "-T -C preview-test worminald --bridge" | "-T -C wheel-test worminald --bridge" | \
  "-T -C key-test worminald --bridge") ;;
  *) exit 64 ;;
esac
if [ -n "${WORMINAL_TEST_BRIDGE_DELAY:-}" ]; then
  sleep "$WORMINAL_TEST_BRIDGE_DELAY"
fi
exec "$WORMINAL_TEST_DAEMON" --bridge
